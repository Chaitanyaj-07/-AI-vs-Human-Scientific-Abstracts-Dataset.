def create_demo_dataset():
    """Create a realistic demo dataset when real data isn't available"""
    np.random.seed(42)
    n_samples = 300
    
    # Domains
    domains = ['Biology', 'Computer Science', 'Medicine', 'Physics', 'Psychology']
    
    # Generate base data
    data = {
        'abstract_id': [f'ABS_{i:05d}' for i in range(n_samples)],
        'domain': np.random.choice(domains, n_samples),
        'author_type': np.random.choice(['Human', 'AI'], n_samples, p=[0.5, 0.5]),
        'publication_year': np.random.choice([2020, 2021, 2022, 2023, 2024, 2025], n_samples),
        'readability_score': np.random.normal(14, 2.5, n_samples),
        'avg_word_length': np.random.normal(5.2, 0.4, n_samples),
        'sentence_count': np.random.poisson(10, n_samples),
        'hedging_words_count': np.random.poisson(4, n_samples),
        'citation_count': np.random.poisson(5, n_samples),
        'technical_jargon_ratio': np.random.beta(5, 10, n_samples),
        'subjectivity_score': np.random.beta(3, 8, n_samples),
        'first_person_pronouns': np.random.poisson(3, n_samples),
        'passive_voice_ratio': np.random.beta(4, 6, n_samples),
        'has_statistical_results': np.random.choice([0, 1], n_samples, p=[0.3, 0.7]),
        'conclusion_statement': np.random.choice([0, 1], n_samples, p=[0.4, 0.6]),
    }
    
    df_demo = pd.DataFrame(data)
    
    # Make AI/Human differences realistic
    ai_mask = df_demo['author_type'] == 'AI'
    human_mask = ~ai_mask
    
    # Humans use more hedging words
    df_demo.loc[human_mask, 'hedging_words_count'] = np.random.poisson(5, human_mask.sum())
    df_demo.loc[ai_mask, 'hedging_words_count'] = np.random.poisson(2, ai_mask.sum())
    
    # Humans use more first-person pronouns
    df_demo.loc[human_mask, 'first_person_pronouns'] = np.random.poisson(4, human_mask.sum())
    df_demo.loc[ai_mask, 'first_person_pronouns'] = np.random.poisson(1, ai_mask.sum())
    
    # AI tends to have more consistent readability
    df_demo.loc[human_mask, 'readability_score'] = np.random.normal(14, 3, human_mask.sum())
    df_demo.loc[ai_mask, 'readability_score'] = np.random.normal(13.5, 1.5, ai_mask.sum())
    
    # Add target variable
    df_demo['human_written'] = (df_demo['author_type'] == 'Human').astype(int)
    
    # Generate sample abstracts for word clouds
    human_abstracts = [
        "In this study, we investigated the effects of CRISPR-Cas9 gene editing on human embryos. Our results suggest that off-target effects may be less common than previously thought. We observed significant improvements in editing efficiency when using modified guide RNAs. These findings could have important implications for therapeutic applications.",
        "We conducted a longitudinal study of 500 adolescents to examine social media's impact on mental health. Our analysis revealed that passive consumption correlated with increased anxiety scores. Interestingly, we found that active creation had protective effects. These results indicate the need for nuanced digital wellness guidelines.",
        "Here we present a randomized controlled trial of a novel antihypertensive combination therapy. Our data show significant blood pressure reduction compared to monotherapy. We observed minimal adverse events across both groups. These findings support combination therapy as first-line treatment."
    ]
    
    ai_abstracts = [
        "This paper introduces a novel transformer architecture optimized for low-resource languages. The proposed model reduces computational complexity while maintaining performance. Experiments on four African languages demonstrate 42% faster inference. The results indicate that efficient attention mechanisms can democratize NLP.",
        "Quantum entanglement is demonstrated in a 5x5 superconducting qubit array. Two-qubit gate fidelities of 99.2% are achieved at millikelvin temperatures. Decoherence times represent significant improvement over previous architectures. This work marks progress toward fault-tolerant quantum computing.",
        "A deep learning approach for protein structure prediction is presented. The model achieves state-of-the-art accuracy on benchmark datasets. Attention mechanisms capture long-range dependencies in amino acid sequences. This method could accelerate drug discovery and protein engineering."
    ]
    
    # Assign abstracts based on author type
    df_demo.loc[human_mask, 'abstract_text'] = np.random.choice(human_abstracts, human_mask.sum())
    df_demo.loc[ai_mask, 'abstract_text'] = np.random.choice(ai_abstracts, ai_mask.sum())
    
    return df_demo

