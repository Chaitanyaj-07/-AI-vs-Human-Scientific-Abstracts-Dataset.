# 8. BASELINE ML MODEL
# =============================================================================

print("\n" + "="*60)
print(" BASELINE MACHINE LEARNING MODEL")
print("="*60)

# Prepare features for ML
feature_cols = [col for col in numeric_cols if col != 'human_written']
feature_cols = feature_cols[:10]  # Limit to top 10 features

if len(feature_cols) >= 3 and 'human_written' in df.columns:
    # Prepare data
    X = df[feature_cols].copy()
    y = df['human_written'].copy()
    
    # Handle any infinite values
    X = X.replace([np.inf, -np.inf], np.nan)
    X = X.fillna(X.median())
    
    # Scale features
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    X_scaled = pd.DataFrame(X_scaled, columns=X.columns)
    
    # Split data
    X_train, X_test, y_train, y_test = train_test_split(
        X_scaled, y, test_size=0.2, random_state=42, stratify=y
    )
    
    print(f" Data prepared: {X_train.shape[0]} training samples, {X_test.shape[0]} test samples")
    
    # Train models
    models = {
        'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42),
        'Random Forest': RandomForestClassifier(n_estimators=50, max_depth=5, random_state=42)
    }
    
    results = {}
    for name, model in models.items():
        model.fit(X_train, y_train)
        y_pred = model.predict(X_test)
        y_proba = model.predict_proba(X_test)[:, 1]
        
        accuracy = (y_pred == y_test).mean()
        auc = roc_auc_score(y_test, y_proba)
        results[name] = {'accuracy': accuracy, 'auc': auc, 'model': model}
        
        print(f"\n{name}:")
        print(f"  Accuracy: {accuracy:.3f}")
        print(f"  AUC-ROC: {auc:.3f}")
    
    # Feature importance from Random Forest
    if 'Random Forest' in results:
        rf = results['Random Forest']['model']
        importance = pd.DataFrame({
            'feature': feature_cols,
            'importance': rf.feature_importances_
        }).sort_values('importance', ascending=False)
        
        print("\n Top 5 Important Features:")
        display(importance.head(5))
        
        # Plot feature importance
        plt.figure(figsize=(10, 5))
        plt.barh(importance['feature'][:8], importance['importance'][:8], color='#4ECDC4')
        plt.xlabel('Importance')
        plt.title('Feature Importance - Random Forest')
        plt.gca().invert_yaxis()
        plt.tight_layout()
        plt.show()
    
    # Confusion matrix for best model
    best_model = max(results, key=lambda x: results[x]['auc'])
    best_pred = models[best_model].predict(X_test)
    
    plt.figure(figsize=(6, 5))
    cm = confusion_matrix(y_test, best_pred)
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
                xticklabels=['AI', 'Human'],
                yticklabels=['AI', 'Human'])
    plt.title(f'Confusion Matrix - {best_model}')
    plt.xlabel('Predicted')
    plt.ylabel('Actual')
    plt.tight_layout()
    plt.show()

